ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx
# Optional: Use company API endpoint instead of default
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com

# Ollama for secure mode (local)
OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL=granite3.2-vision:2b
VISION_MAX_TOKENS=500
TEXT_MAX_TOKENS=700
# Set true only to add a slower visual audit after text structuring.
ENABLE_VISION_VERIFICATION=false
LOCAL_SCAN_CONCURRENCY=1
# Repeated scans are cached only in process memory; nothing is written to disk.
EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_TTL_SECONDS=3600
EXTRACTION_CACHE_MAX_ENTRIES=100
OCR_LANGUAGES=eng
OCR_PSM_DEFAULT=3
OCR_PSM_RETRY=6
OCR_MIN_CONFIDENCE=70
MAX_INPUT_PIXELS=48000000

# Google Sheets (optional)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEET_ID=

# Server
HOST=0.0.0.0
PORT=5000
